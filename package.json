    "grokbot:packet": "node src/grokbot/cli.js packet",
    "grokbot:build": "node scripts/build-grokbot.mjs",
    "grokbot:screenshots": "node scripts/render-grokbot.mjs"
  },
  "keywords": [
    "memes",
    "bot",
    "ai",
    "internet-culture",
    "captions",
    "humor",
    "grokbot",
    "solana",
    "creative-workflow"
  ],
