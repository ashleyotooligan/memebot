{
  "name": "memebot",
  "version": "0.3.0",
  "description": "A meme-native creative workflow with a Grok Bot operator pack, shared briefs and reviewable drafts.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/demo.js",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/memebot.js && node scripts/check-grokbot.mjs",
